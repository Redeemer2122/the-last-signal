---
import "../styles/global.css";
import "../styles/sequence.css";
import "../styles/sections.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "THE LAST SIGNAL — An Interactive Transmission",
  description = "A cinematic scroll-driven experience following an unknown transmission into an abandoned mountain radio station.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05080c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/sequences/the-last-signal/posters/poster-desktop.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%2305080c%22/><circle cx=%2250%22 cy=%2250%22 r=%2212%22 fill=%22%23d33a34%22/></svg>" />
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#signal-data">Skip cinematic sequence</a>
    <slot />
  </body>
</html>
